generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Product {
  id             String      @id @default(cuid())
  name           String
  description    String
  imageUrl       String
  category       String      @default("Geral")
  priceCents     Int
  costCents      Int?
  stock          Int         @default(0)
  manualSoldOut  Boolean     @default(false)
  active         Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  orderItems     OrderItem[]
}

model Setting {
  id               String @id @default("main")
  deliveryFeeCents Int    @default(500)
}

model Order {
  id                    String          @unique @default(cuid())
  number                Int             @id @default(autoincrement())
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  customerName          String
  phone                 String
  phoneNormalized       String?
  deliveryMethod        DeliveryMethod
  address               String?
  addressNumber         String?
  complement            String?
  neighborhood          String?
  reference             String?
  subtotalCents         Int
  deliveryFeeCents      Int
  totalCents            Int
  feeCents              Int             @default(0)
  paymentMethod         PaymentMethod
  paymentStatus         PaymentStatus   @default(PENDING)
  checkoutToken         String?         @unique
  cashTenderedCents     Int?
  cashChangeCents       Int?
  orderStatus           OrderStatus     @default(RECEIVED)
  paymentId             String?
  preferenceId          String?
  pixProofUrl           String?
  pixProofMime          String?
  pixProofStatus        PixProofStatus  @default(NONE)
  pixProofUploadedAt    DateTime?
  pixProofConfirmedAt   DateTime?
  pixProofConfirmedBy   String?
  whatsappSendingAt     DateTime?
  whatsappSentAt        DateTime?
  whatsappMessageId     String?
  items                 OrderItem[]
  loyaltyEvents         FidelityEvent[]
}

model FidelityAccount {
  id              String          @id @default(cuid())
  phoneNormalized String          @unique
  points          Int             @default(0)
  queuedPoints    Int             @default(0)
  validOrdersCount Int            @default(0)
  reviewRequired  Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  rewards         FidelityReward[]
  events          FidelityEvent[]
}

model FidelityReward {
  id          String             @id @default(cuid())
  accountId   String
  cycle       Int
  status      FidelityRewardStatus @default(AVAILABLE)
  createdAt   DateTime           @default(now())
  redeemedAt  DateTime?
  redeemedBy  String?
  account     FidelityAccount    @relation(fields: [accountId], references: [id], onDelete: Restrict)
  events      FidelityEvent[]

  @@unique([accountId, cycle])
  @@index([accountId, status])
}

model FidelityEvent {
  id             String             @id @default(cuid())
  accountId      String
  orderId        String?
  rewardId       String?
  type           FidelityEventType
  bucket         FidelityPointBucket?
  cycle          Int?
  pointsDelta    Int                @default(0)
  idempotencyKey String             @unique
  note           String?
  createdBy      String?
  reviewResolution String?
  resolvedBy      String?
  resolvedAt      DateTime?
  createdAt      DateTime           @default(now())
  account        FidelityAccount    @relation(fields: [accountId], references: [id], onDelete: Restrict)
  order          Order?             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  reward         FidelityReward?    @relation(fields: [rewardId], references: [id], onDelete: Restrict)

  @@index([accountId, createdAt])
  @@index([orderId])
}

model CashMovement {
  id          String            @id @default(cuid())
  createdAt   DateTime          @default(now())
  type        CashMovementType
  amountCents Int
  description String
  createdBy   String?
}

model CashClosure {
  id                    String   @id @default(cuid())
  createdAt             DateTime @default(now())
  closedAt              DateTime @default(now())
  openingBalanceCents   Int
  totalSoldCents        Int
  totalReceivedCents    Int
  cashCents             Int
  pixCents              Int
  cardCents             Int
  feesCents             Int
  expensesCents         Int
  manualEntriesCents    Int
  manualOutputsCents    Int
  closingBalanceCents   Int
  profitCents           Int
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  productId      String
  productName    String
  unitPriceCents Int
  quantity       Int
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product @relation(fields: [productId], references: [id])
}

enum DeliveryMethod {
  DELIVERY
  PICKUP
}

enum PaymentMethod {
  PIX
  CARD
  CASH
  CARD_ON_DELIVERY
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum OrderStatus {
  RECEIVED
  PAYMENT_PENDING
  PAID
  PREPARING
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELLED
}

enum CashMovementType {
  ENTRY
  OUTPUT
}

enum PixProofStatus {
  NONE
  SENT
  CONFIRMED
  REJECTED
}

enum FidelityRewardStatus {
  AVAILABLE
  REVIEW_REQUIRED
  REDEEMED
  REVOKED
}

enum FidelityEventType {
  POINT_EARNED
  POINT_REVERSED
  POINT_ADJUSTED
  REWARD_ISSUED
  REWARD_REDEEMED
}

enum FidelityPointBucket {
  ACTIVE
  QUEUED
}
